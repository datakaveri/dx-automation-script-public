{
  "keycloak": {
    "url": "https://<keycloak-host>/auth",
    "realm": "<realm>",
    "admin_client_id": "<admin-client-id>",
    "admin_client_secret": "${KC_ADMIN_SECRET:-}",
    "timeout_seconds": 30,
    "verify_tls": true
  },
  "target": {
    "usernames": [],
    "prefix": "e2e-",
    "protected_usernames": [
      "<borrowed-cos-admin-username>",
      "<borrowed-ogc-provider-username>"
    ],
    "older_than_hours": 0
  },
  "delete": {
    "verify": true,
    "print_user_ids": true
  },
  "logging": {
    "level": "INFO"
  }
}
