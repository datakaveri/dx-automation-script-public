{
  "control_plane": {
    "base_url": "https://<controlplane-host>",
    "timeout_seconds": 30,
    "verify_tls": true
  },
  "keycloak": {
    "url": "https://<keycloak-host>/auth",
    "realm": "<realm>",
    "admin_client_id": "<admin-client-id>",
    "admin_client_secret": "${KC_ADMIN_SECRET:-}",
    "user_client_id": "<public-client-id>",
    "user_client_secret": "",
    "timeout_seconds": 30,
    "verify_tls": true
  },
  "target": {
    "username": "",
    "user_id": "",
    "password": "",
    "org_id": "",
    "input_file": "../creation/provider_created.json",
    "require_input_file": false,
    "remove_input_file": true
  },
  "org_admin": {
    "username": "<org-admin-username>",
    "password": "${ORG_ADMIN_PASS:-}",
    "token": ""
  },
  "delete": {
    "mode": "auto",
    "remove_from_organisation": false,
    "pause_seconds": 0,
    "verify": true,
    "verify_timeout_seconds": 30,
    "verify_poll_seconds": 2
  },
  "endpoints": {
    "kc_token": "/realms/{realm}/protocol/openid-connect/token",
    "kc_users": "/admin/realms/{realm}/users",
    "kc_user": "/admin/realms/{realm}/users/{user_id}",
    "kc_realm_role": "/admin/realms/{realm}/roles/{role}",
    "kc_role_mappings": "/admin/realms/{realm}/users/{user_id}/role-mappings/realm",
    "cp_user_delete": "/iudx/v2/auth/user/delete",
    "cp_org_user": "/iudx/v2/auth/organisations/{org_id}/users/{user_id}"
  },
  "logging": {
    "level": "INFO",
    "print_requests": true,
    "print_responses": true,
    "response_preview_chars": 2000,
    "mask_secrets": false
  }
}
