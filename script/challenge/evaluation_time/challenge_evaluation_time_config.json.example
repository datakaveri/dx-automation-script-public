{
  "community": {
    "base_url": "https://v2.dev.iudx.io/community",
    "timeout_seconds": 30,
    "verify_tls": true
  },
  "keycloak": {
    "url": "https://v2.dev.iudx.io/auth",
    "realm": "iudx-v2",
    "user_client_id": "frontend-client",
    "user_client_secret": "",
    "timeout_seconds": 30,
    "verify_tls": true
  },
  "cos_admin": {
    "username": "${COS_ADMIN_USER:-cos-admin@example.com}",
    "password": "${COS_ADMIN_PASS}",
    "token": ""
  },
  "target": {
    "competition_id": "",
    "title": "",
    "input_file": "../creation/challenge_created.json",
    "require_input_file": false,
    "update_input_file": true
  },
  "times": {
    "creation": "today",
    "evaluation_end": "today+21d"
  },
  "update": {
    "draft": true,
    "require_status": [
      "DRAFT",
      "SCHEDULED"
    ],
    "expect_http_status": [
      200
    ],
    "verify_after": true,
    "expect_status": "",
    "settle_seconds": 0,
    "extra_fields": {}
  },
  "lookup": {
    "choices": [
      "draft",
      "scheduled",
      "published",
      "evaluation",
      "completed",
      "cancelled"
    ],
    "page_size": 100,
    "max_pages": 20,
    "use_query": false
  },
  "time_format": {
    "timezone": "Asia/Kolkata",
    "date_formats": [
      "%Y-%m-%d",
      "%d-%m-%Y",
      "%d/%m/%Y",
      "%Y-%m-%dT%H:%M:%S%z",
      "%Y-%m-%d %H:%M",
      "%Y-%m-%dT%H:%M:%S",
      "%Y-%m-%d %H:%M:%S"
    ],
    "send_date_format": "%Y-%m-%d",
    "send_datetime_format": "iso"
  },
  "validate": {
    "mode": "auto",
    "starts_not_before_publish": true,
    "ends_after_starts": true,
    "evaluation_after_ends": true
  },
  "endpoints": {
    "kc_token": "/realms/{realm}/protocol/openid-connect/token",
    "admin_get": "/challenge/admin/challenge/{competition_id}",
    "admin_update": "/challenge/admin/challenge/{competition_id}",
    "admin_list": "/challenge/admin/challenges/{choice}"
  },
  "logging": {
    "level": "INFO",
    "print_requests": true,
    "print_responses": true,
    "response_preview_chars": 2000,
    "mask_secrets": false
  }
}
