{
  "community": {
    "base_url": "https://v2.dev.iudx.io/community",
    "timeout_seconds": 30,
    "verify_tls": true
  },
  "keycloak": {
    "url": "https://v2.dev.iudx.io/auth",
    "realm": "iudx-v2",
    "user_client_id": "frontend-client",
    "user_client_secret": "",
    "timeout_seconds": 30,
    "verify_tls": true
  },
  "cos_admin": {
    "username": "${COS_ADMIN_USER:-cos-admin@example.com}",
    "password": "${COS_ADMIN_PASS}",
    "token": ""
  },
  "target": {
    "competition_id": "",
    "title": "",
    "input_file": "../creation/challenge_created.json",
    "require_input_file": false,
    "remove_input_file": true
  },
  "delete": {
    "allowed_statuses": [
      "DRAFT",
      "SCHEDULED"
    ],
    "expect_http_status": [
      200
    ],
    "verify_after": true,
    "expect_gone_status": [
      404
    ],
    "settle_seconds": 0
  },
  "lookup": {
    "choices": [
      "draft",
      "scheduled",
      "published",
      "evaluation",
      "completed",
      "cancelled"
    ],
    "page_size": 100,
    "max_pages": 20,
    "use_query": false
  },
  "endpoints": {
    "kc_token": "/realms/{realm}/protocol/openid-connect/token",
    "admin_get": "/challenge/admin/challenge/{competition_id}",
    "admin_delete": "/challenge/admin/challenges/{competition_id}",
    "admin_list": "/challenge/admin/challenges/{choice}"
  },
  "logging": {
    "level": "INFO",
    "print_requests": true,
    "print_responses": true,
    "response_preview_chars": 2000,
    "mask_secrets": false
  }
}
